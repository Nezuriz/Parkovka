generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusTransaksi {
  masuk
  keluar
}

enum RoleUser {
  admin
  petugas
  owner
}

model User {
  id_user       Int            @id @default(autoincrement())
  nama_lengkap  String         @db.VarChar(50)
  username      String         @unique @db.VarChar(50)
  password      String         @db.VarChar(100)
  role          RoleUser       @default(petugas)
  status_aktif  Boolean        @default(true)

  transaksi     Transaksi[]
  log_aktivitas LogAktivitas[]
  @@map("tb_user")
}

model AreaParkir {
  id_area   Int         @id @default(autoincrement())
  nama_area String      @db.VarChar(50)
  kapasitas Int
  terisi    Int         @default(0)

  transaksi Transaksi[]
  @@map("tb_area_parkir")
}

model JenisKendaraan {
  id_jenis      Int         @id @default(autoincrement())
  nama_jenis    String      @unique @db.VarChar(50) 
  tarif_per_jam Decimal     @db.Decimal(10, 0)       

  transaksi     Transaksi[]
  @@map("tb_jenis_kendaraan")
}

model Transaksi {
  id_parkir    Int             @id @default(autoincrement())
  plat_nomor   String          @db.VarChar(15) 
  waktu_masuk  DateTime        @default(now()) @db.Timestamp(0)
  waktu_keluar DateTime?       @db.Timestamp(0) 
  durasi_jam   Int?            
  biaya_total  Decimal?        @db.Decimal(10, 0) 
  status       StatusTransaksi @default(masuk)
  id_user      Int
  id_area      Int
  id_jenis     Int             
  
  user            User           @relation(fields: [id_user], references: [id_user], onDelete: Restrict)
  area_parkir     AreaParkir     @relation(fields: [id_area], references: [id_area], onDelete: Restrict)
  jenis_kendaraan JenisKendaraan @relation(fields: [id_jenis], references: [id_jenis], onDelete: Restrict)

  @@map("tb_transaksi")
}

model LogAktivitas {
  id_log          Int      @id @default(autoincrement())
  id_user         Int
  aktivitas       String   @db.VarChar(100)
  waktu_aktivitas DateTime @default(now()) @db.Timestamp(0)

  user            User     @relation(fields: [id_user], references: [id_user], onDelete: Cascade)
  @@map("tb_log_aktivitas")
}